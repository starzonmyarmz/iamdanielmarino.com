---
import "../styles/style.css"
import type { Accent } from "../lib/accent"

interface Props {
  title: string
  accent?: Accent
}

const { title, accent } = Astro.props

const navLinks = [
  { label: "Posts", href: "/posts" },
  { label: "Projects", href: "/projects" },
  { label: "Uses", href: "/uses" },
  { label: "Feed", href: "/feed.xml" },
]
---

<!doctype html>
<html lang="en" data-l={accent && `${accent.l}%`} data-c={accent?.c} data-h={accent?.h}>
  <head>
    <meta charset="utf-8" />
    <title>{title} &mdash; Daniel Marino</title>
    <meta
      name="description"
      content="Daniel Marino is passionate about crafting simple, high-quality experiences."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Daniel Marino"
      href="https://iamdanielmarino.com/feed.xml"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="black" />
  </head>

  <body>
    <div id="redesign">👋🏻 Hey! This site is undergoing a live redesign. How fun!</div>

    <header>
      <a href="/" id="logo" aria-label="Daniel Marino">Daniel Marino</a>

      <nav>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main>
      <div class="content">
        <slot />
      </div>
    </main>

    <footer>
      <nav>
        <ul>
          <li><a href="https://letterbird.co/iamdanielmarino">Contact</a></li>
          <li><a href="https://github.com/starzonmyarmz">GitHub</a></li>
          <li><a href="https://codepen.io/starzonmyarmz">CodePen</a></li>
        </ul>
      </nav>

      <p>
        Built with <a href="https://astro.build">Astro</a> and <a href="https://preactjs.com"
          >Preact</a
        >. Set in <a href="https://fonts.google.com/specimen/Work+Sans">Work Sans</a> and <a
          href="https://fonts.google.com/specimen/Montserrat">Montserrat</a
        >.
      </p>

      <p>© 2026 Daniel Marino</p>
    </footer>

    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://starzonmyarmz.goatcounter.com/count"
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
