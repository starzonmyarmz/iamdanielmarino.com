---
import "../styles/style.css"

interface Props {
  title: string
}

const { title } = Astro.props

const navLinks = [
  { label: "Posts", href: "/posts" },
  { label: "Uses", href: "/uses" },
  { label: "Subs", href: "/subs" },
  { label: "Feed", href: "/feed.xml" },
  { label: "Contact", href: "https://letterbird.co/iamdanielmarino" },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} &mdash; Daniel Marino</title>
    <meta
      name="description"
      content="Daniel Marino is passionate about crafting simple, high-quality experiences."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Daniel Marino"
      href="https://iamdanielmarino.com/feed.xml"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="black" />
  </head>

  <body>
    <div id="redesign">👋🏻 Hey! This site is undergoing a live redesign. How fun!</div>

    <header>
      <a href="/" id="logo" aria-label="Daniel Marino">Daniel Marino</a>

      <nav>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main>
      <div class="content">
        <slot />
      </div>
    </main>

    <footer>
      <p>© 2026 Daniel Marino</p>
    </footer>

    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://starzonmyarmz.goatcounter.com/count"
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
