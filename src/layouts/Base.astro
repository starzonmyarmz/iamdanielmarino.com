---
import "../styles/main.css"

interface Props {
  title: string
}

const { title } = Astro.props
const { pathname } = Astro.url
const noindex = pathname.startsWith("/resume")
const showHeadshot = pathname === "/"
const ariaCurrent = (href: string) =>
  pathname.replace(/\/$/, "") === href.replace(/\/$/, "") ? "page" : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title} &mdash; Daniel Marino</title>
    <meta
      name="description"
      content="Daniel Marino is passionate about crafting simple, high-quality experiences."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {noindex && <meta name="robots" content="noindex" />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Daniel Marino"
      href="https://iamdanielmarino.com/feed.xml"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="black" />
    <link
      rel="preload"
      href="/SourceSerif-Roman-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />  </head>

  <body>
    <nav>
      <ul>
        <li>
          <a href="/" id="logo" aria-label="Daniel Marino" aria-current={ariaCurrent("/")}>DM</a>
        </li>
        <li>
          <a href="/work" aria-current={ariaCurrent("/work")}>Work</a>
        </li>
        <li>
          <a href="/projects" aria-current={ariaCurrent("/projects")}>Projects</a>
        </li>
        <li>
          <a href="/posts" aria-current={ariaCurrent("/posts")}>Posts</a>
        </li>
        <li>
          <a href="/feed.xml">Feed</a>
        </li>
      </ul>
    </nav>

    <main>
      {
        showHeadshot && (
          <img
            src="/images/headshot.webp"
            alt="Headshot of Daniel Marino"
            width="128"
            height="128"
            id="headshot"
          />
        )
      }
      <slot />
    </main>

    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://starzonmyarmz.goatcounter.com/count"
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
