---
interface Props {
  size?: number
}

const { size = 70 } = Astro.props

const s = size // edge length of one face
const dx = (s * Math.sqrt(3)) / 2 // horizontal run of each diagonal edge
const dy = s / 2 // vertical rise of each diagonal edge

const w = dx * 2 // total width  = s·√3
const H = s + dy * 2 // total height = 2s
---

<svg width={w} height={H} viewBox={`0 0 ${w} ${H}`} xmlns="http://www.w3.org/2000/svg">
  <polygon points={`${dx},0 ${w},${dy} ${dx},${dy * 2} 0,${dy}`} fill="#8ab4f8"></polygon>
  <polygon points={`0,${dy} ${dx},${dy * 2} ${dx},${dy * 2 + s} 0,${dy + s}`} fill="#4285f4"
  ></polygon>
  <polygon points={`${w},${dy} ${w},${dy + s} ${dx},${dy * 2 + s} ${dx},${dy * 2}`} fill="#1a5fd4"
  ></polygon>
</svg>
