---
import { generateCluster, voxelsToGroups, groupsBounds } from "../lib/voxel"
import VoxelArt from "./VoxelArt"

interface Props {
  seed: string
  hue: number
}

const { seed, hue } = Astro.props
const grid = 4
const voxels = generateCluster(seed, grid, hue)
const groups = voxelsToGroups(voxels, 18)
const { minX, minY, w, h } = groupsBounds(groups, 18)
---

<VoxelArt groups={groups} minX={minX} minY={minY} w={w} h={h} client:visible />
