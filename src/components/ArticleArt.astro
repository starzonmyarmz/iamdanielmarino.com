---
import { generateCluster, voxelsToGroups, groupsBounds } from "../lib/voxelArt"

interface Props {
  seed: string
  size?: number
  grid?: number
}

const { seed, size = 26, grid = 4 } = Astro.props

const voxels = generateCluster(seed, grid)
const groups = voxelsToGroups(voxels, size)
const { minX, minY, w, h } = groupsBounds(groups, size * 0.5)
---

<div class="article-art-frame">
  <svg
    viewBox={`${minX} ${minY} ${w} ${h}`}
    xmlns="http://www.w3.org/2000/svg"
    class="article-art"
    shape-rendering="crispEdges"
    aria-hidden="true"
  >
    {
      groups.map((g) => (
        // Left-to-right wave: cubes sharing an (x - y) column float in
        // phase, neighboring columns lag behind, rippling across the grid.
        // Both data attributes live here; CSS reads wave-delay directly
        // and re-exposes fill as a custom property so descendants
        // (.voxel-float, .voxel-cube, each face) can inherit it.
        <g class="voxel" data-wave-delay={g.wavePhase} data-fill={g.fill}>
          <g class="voxel-float">
            <g class="voxel-cube">
              {g.faces.map((f) => (
                <polygon points={f.points} data-face={f.face} />
              ))}
            </g>
          </g>
        </g>
      ))
    }
  </svg>
</div>
