---
import { generateCluster, voxelsToGroups, groupsBounds } from "../lib/voxelArt"

interface Props {
  seed: string
  size?: number
  grid?: number
  href?: string
}

const { seed, size = 26, grid = 4, href } = Astro.props

const voxels = generateCluster(seed, grid).map((v) => ({ ...v, href }))
const groups = voxelsToGroups(voxels, size)
const { minX, minY, w, h } = groupsBounds(groups, size * 0.5)
---

<svg
  viewBox={`${minX} ${minY} ${w} ${h}`}
  xmlns="http://www.w3.org/2000/svg"
  class="article-art"
  shape-rendering="crispEdges"
>
  {
    groups.map((g) => (
      <g class="voxel">
        {g.href ? (
          <a href={g.href}>
            {g.faces.map((f) => (
              <polygon
                points={f.points}
                fill={f.fill}
                stroke="rgba(0, 0, 0, 1)"
                stroke-width="0.2"
                stroke-linejoin="round"
              />
            ))}
          </a>
        ) : (
          g.faces.map((f) => (
            <polygon
              points={f.points}
              fill={f.fill}
              stroke="rgba(0, 0, 0, 1)"
              stroke-width="0.2"
              stroke-linejoin="round"
            />
          ))
        )}
      </g>
    ))
  }
</svg>
