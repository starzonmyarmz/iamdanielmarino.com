---
import { getCollection, type CollectionEntry } from "astro:content"
import { Image } from "astro:assets"
import Base from "../../layouts/Base.astro"
import ProjectMeta from "../../components/ProjectMeta.astro"
import { projectCategories } from "../../projectCategories"

const projects = await getCollection("projects")

const hasPage = (project: CollectionEntry<"projects">) => Boolean(project.body?.trim())

const sections = Object.entries(projectCategories).map(([category, title]) => ({
  title,
  items: projects
    .filter((project) => project.data.category === category)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
}))
---

<Base title="Projects">
  <header>
    <h1>Projects</h1>
  </header>

  <p>
    Things I make outside of work: audio plugins, games, apps, art and music. Some are polished,
    some are experiments, and a few are just for me.
  </p>

  {
    sections.map(({ title, items }) => (
      <section class="projects">
        <h2>{title}</h2>
        <ul>
          {items.map((project) => {
            const { title, blurb, url, icon } = project.data
            return (
              <li>
                <Image src={icon} alt="" width={224} class="project-icon" />
                <div>
                  <h3>
                    <a href={hasPage(project) ? `/projects/${project.id}/` : url}>{title}</a>
                  </h3>
                  <p>{blurb}</p>
                  <ProjectMeta project={project} />
                </div>
              </li>
            )
          })}
        </ul>
      </section>
    ))
  }
</Base>
