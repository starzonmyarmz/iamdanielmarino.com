---
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import Base from "../../layouts/Base.astro"
import { projectCategories } from "../../projectCategories"

const projects = await getCollection("projects")

const sections = Object.entries(projectCategories).map(([category, title]) => ({
  title,
  items: projects
    .filter((project) => project.data.category === category)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
}))

const buyLabels: Record<string, (price: string) => string> = {
  "gumroad.com": (price) => `${price} on Gumroad`,
  "bandcamp.com": (price) => `${price} on Bandcamp`,
  "etsy.com": (price) => `${price} on Etsy`,
}

const buyLabel = (url: string, price: string) => {
  const { hostname } = new URL(url)
  return Object.entries(buyLabels).find(([host]) => hostname.endsWith(host))?.[1](price)
}
---

<Base title="Projects">
  <header>
    <h1>Projects</h1>
  </header>

  <p>
    Things I make outside of work: audio plugins, games, apps, art and music. Some are polished,
    some are experiments, and a few are just for me.
  </p>

  {sections.map(({ title, items }) => (
    <section class="projects">
      <h2>{title}</h2>
      <ul>
        {items.map((project) => {
          const { title, blurb, url, icon, platforms, price, storeUrl = url } = project.data
          const label = storeUrl && price && buyLabel(storeUrl, price)
          return (
            <li>
              <Image src={icon} alt="" width={224} class="project-icon" />
              <div>
                <h3>{url ? <a href={url}>{title}</a> : title}</h3>
                <p>{blurb}</p>
                {(platforms || label) && (
                  <small>
                    {platforms}
                    {platforms && label && " · "}
                    {label && <a href={storeUrl}>{label}</a>}
                  </small>
                )}
              </div>
            </li>
          )
        })}
      </ul>
    </section>
  ))}

  <script is:inline src="https://gumroad.com/js/gumroad.js" async></script>
</Base>
