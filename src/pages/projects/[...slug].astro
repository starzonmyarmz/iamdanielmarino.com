---
import { getCollection, getEntries, render } from "astro:content"
import { Image } from "astro:assets"
import Base from "../../layouts/Base.astro"
import ProjectMeta from "../../components/ProjectMeta.astro"

export async function getStaticPaths() {
  const projects = await getCollection("projects", (project) => Boolean(project.body?.trim()))
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { title, blurb, image, imageAlt, links } = entry.data
const { Content } = await render(entry)
const posts = await getEntries(entry.data.posts)
---

<Base title={title}>
  <article>
    <header>
      <h1>{title}</h1>
      <p>{blurb}</p>
      <ProjectMeta project={entry}>
        {links.map(({ label, url }) => <a href={url}>{label}</a>)}
      </ProjectMeta>
    </header>

    {image && <Image src={image} alt={imageAlt ?? ""} width={1200} class="project-image" />}

    <Content />

    {
      posts.length > 0 && (
        <>
          <h2>Posts</h2>
          <ul>
            {posts.map((post) => (
              <li>
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </article>
</Base>
