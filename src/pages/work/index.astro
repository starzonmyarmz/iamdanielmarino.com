---
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro"

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order)
---

<Layout title="Work">
  <header>
    <h1>Work</h1>
  </header>

  <p>
    Selected case studies from my 12 years of experience at <a href="https://getharvest.com"
      >Harvest</a
    >, showcasing notable projects I was actively engaged in:
  </p>

  <ul>
    {
      work.map((item) => (
        <li>
          <h2>
            <a href={`/work/${item.data.slug}/`}>{item.data.title}</a>
          </h2>
          <p>{item.data.blurb}</p>
        </li>
      ))
    }
  </ul>

  <p>
    Check out <a href="https://dribbble.com/starzonmyarmz">Dribbble</a> and <a
      href="https://github.com/starzonmyarmz">GitHub</a
    > for more examples of my work.
  </p>
</Layout>
